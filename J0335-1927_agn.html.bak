    mounted() {
        this.allDatasets.forEach((data, i) => this.renderPlot(i, data));
    },
    methods: {
        renderPlot(index, data) {
            const traces = data.curves.map(c => ({
                x: c.x, y: c.y, name: c.name,
                type: 'scatter', mode: 'markers',
                marker: { size: 4, color: c.color },
                error_y: c.showErrors ? { type: 'data', array: c.err, visible: true, thickness: 1, width: 0 } : {},
                hovertemplate: '<b>%{name}</b><br>MJD: %{x}<br>Mag: %{y:.3f}<extra></extra>'
            }));

            const layout = {
                margin: { t: 10, r: 10, b: 35, l: 45 },
                xaxis: { title: 'MJD', tickfont: {size: 10}, gridcolor: '#f0f0f0' },
                yaxis: { title: 'Mag', autorange: 'reversed', tickfont: {size: 10}, gridcolor: '#f0f0f0' },
                showlegend: false,
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: '#fdfdfd'
            };

            Plotly.newPlot('plot-' + index, traces, layout, {responsive: true, displaylogo: false});
        }
    }
});
